        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class NguoiDung {\n        +String maNguoiDung\n        +String hoTen\n        +String vaiTro\n        +phanQuyen()\n    }\n\n    class KhachHang {\n        +String maKhachHang\n        +String tenKhachHang\n        +capNhatThongTin()\n    }\n\n    class DiaDiemGiao {\n        +String maDiaDiem\n        +String diaChiChiTiet\n        +String mien\n        +capNhatDiaChi()\n    }\n\n    class DonHang {\n        +String maDonHang\n        +DateTime ngayLap\n        +String trangThai\n        +lapDon()\n        +huyDon()\n    }\n\n    class YeuCauGiao {\n        +String maYeuCau\n        +DateTime nhanSomNhat\n        +DateTime nhanMuonNhat\n        +String trangThai\n        +kiemTraHoanTat()\n    }\n\n    class ChiTietYeuCau {\n        +int soLuongYeuCau\n        +tinhSoLuongConThieu()\n    }\n\n    class LinhKien {\n        +String maLinhKien\n        +String tenLinhKien\n        +String donViTinh\n    }\n\n    class NhaCungCap {\n        +String maNhaCungCap\n        +String tenNhaCungCap\n        +String thongTinLienHe\n    }\n\n    class XacNhanCungCap {\n        +int soLuongChapNhan\n        +DateTime ngayDuKienDen\n        +String ketQua\n        +ghiNhanPhanHoi()\n    }\n\n    class ChuyenNhap {\n        +String maChuyenNhap\n        +DateTime gioDuKienDen\n        +String trangThai\n        +xacNhanDoXong()\n    }\n\n    class LoNhap {\n        +String maLoNhap\n        +String trangThai\n        +nhapExcel()\n        +xacNhanThucNhan()\n    }\n\n    class ThungHang {\n        +String maThung\n        +int soLuong\n        +float trongLuongCaBiKg\n        +String trangThai\n        +kiemNhan()\n        +ganNhan()\n    }\n\n    class KhuCho {\n        +String maKhu\n        +String mien\n        +int sucChuaThung\n        +kiemTraChoTrong()\n    }\n\n    class Xe {\n        +String maXe\n        +String bienSo\n        +float taiTrongKg\n        +kiemTraKhaDung()\n    }\n\n    class CongKho {\n        +String maCong\n        +String loaiCong\n        +String trangThai\n        +kiemTraSanSang()\n    }\n\n    class LuotPhucVu {\n        +DateTime gioDuKien\n        +DateTime gioVaoCong\n        +DateTime gioRoiCong\n        +phanCong()\n        +giaiPhongCong()\n    }\n\n    class ChuyenXuat {\n        +String maChuyenXuat\n        +String mien\n        +String trangThai\n        +kiemTraTaiTrong()\n        +xacNhanXuat()\n        +xuatPhieuPDF()\n    }\n\n    class DiemGiaoChuyen {\n        +int thuTuGiao\n        +DateTime gioGiaoDuKien\n        +String trangThai\n        +capNhatKetQua()\n    }\n\n    class PhanBoThung {\n        +DateTime ngayGan\n        +String trangThai\n        +ganThung()\n        +huyPhanBo()\n    }\n\n    class KetQuaGiaoHang {\n        +DateTime gioGiaoThucTe\n        +String nguoiNhan\n        +String ketQua\n        +ghiNhanBanGiao()\n    }\n\n    class ChiTietGiao {\n        +int soLuongKhachNhan\n        +int soLuongBiTuChoi\n        +kiemTraSoLuong()\n    }\n\n    NguoiDung \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : lap\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : dat\n    KhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DiaDiemGiao : co\n\n    DonHang \&quot;1\&quot; *-- \&quot;0..*\&quot; YeuCauGiao\n    DiaDiemGiao \&quot;1\&quot; -- \&quot;0..*\&quot; YeuCauGiao\n    YeuCauGiao \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietYeuCau\n    LinhKien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietYeuCau\n\n    ChiTietYeuCau \&quot;1\&quot; -- \&quot;0..*\&quot; XacNhanCungCap\n    NhaCungCap \&quot;1\&quot; -- \&quot;0..*\&quot; XacNhanCungCap\n\n    NhaCungCap \&quot;1\&quot; -- \&quot;0..*\&quot; LoNhap\n    ChuyenNhap \&quot;1\&quot; *-- \&quot;0..*\&quot; LoNhap\n    LoNhap \&quot;1\&quot; *-- \&quot;0..*\&quot; ThungHang\n\n    ChiTietYeuCau \&quot;1\&quot; -- \&quot;0..*\&quot; ThungHang : dap ung\n    KhuCho \&quot;0..1\&quot; -- \&quot;0..*\&quot; ThungHang : bo tri\n\n    Xe \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenNhap\n    Xe \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenXuat\n\n    CongKho \&quot;1\&quot; -- \&quot;0..*\&quot; LuotPhucVu\n    ChuyenNhap \&quot;0..1\&quot; -- \&quot;0..*\&quot; LuotPhucVu\n    ChuyenXuat \&quot;0..1\&quot; -- \&quot;0..*\&quot; LuotPhucVu\n\n    ChuyenXuat \&quot;1\&quot; *-- \&quot;0..*\&quot; DiemGiaoChuyen\n    DiaDiemGiao \&quot;1\&quot; -- \&quot;0..*\&quot; DiemGiaoChuyen\n\n    DiemGiaoChuyen \&quot;1\&quot; -- \&quot;0..*\&quot; PhanBoThung\n    ThungHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhanBoThung\n\n    DiemGiaoChuyen \&quot;1\&quot; -- \&quot;0..*\&quot; KetQuaGiaoHang\n    KetQuaGiaoHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietGiao\n    PhanBoThung \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietGiao&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-417">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
