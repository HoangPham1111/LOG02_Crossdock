        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor QT as Quản trị viên\n    participant UI as Quản lý danh mục\n    participant XL as Xử lý danh mục\n    participant DM as Danh mục\n    participant NV as Dữ liệu nghiệp vụ\n\n    QT-&gt;&gt;UI: Chọn linh kiện, xe, cổng hoặc khu chờ\n    UI-&gt;&gt;XL: Tra cứu danh mục\n    XL-&gt;&gt;DM: Đọc danh sách\n    DM--&gt;&gt;UI: Hiển thị dữ liệu\n    QT-&gt;&gt;UI: Thêm, sửa hoặc ngừng sử dụng\n    UI-&gt;&gt;XL: Gửi nội dung thay đổi\n    XL-&gt;&gt;DM: Kiểm tra mã và thông tin hiện có\n    XL-&gt;&gt;NV: Kiểm tra hàng, chuyến và lịch liên quan\n    NV--&gt;&gt;XL: Kết quả ràng buộc\n\n    alt Dữ liệu và điều kiện hợp lệ\n        XL-&gt;&gt;DM: Lưu thay đổi\n        DM--&gt;&gt;XL: Thành công\n        XL--&gt;&gt;UI: Cập nhật danh sách\n    else Vi phạm ràng buộc\n        XL--&gt;&gt;UI: Thông báo nguyên nhân, không lưu\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-1151">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
