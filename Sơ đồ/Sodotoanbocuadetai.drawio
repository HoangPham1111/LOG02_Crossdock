        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor QT as Quản trị viên\n    participant UI as Tham số\n    participant XL as Xử lý cấu hình\n    participant CF as Cấu hình vận hành\n\n    QT-&gt;&gt;UI: Mở thiết lập tham số\n    UI-&gt;&gt;XL: Yêu cầu cấu hình hiện tại\n    XL-&gt;&gt;CF: Đọc tham số\n    CF--&gt;&gt;UI: Ngưỡng tải, giờ lưu chờ, ngày giao miền Nam\n    QT-&gt;&gt;UI: Nhập giá trị mới và xác nhận\n    UI-&gt;&gt;XL: Gửi yêu cầu cập nhật\n    XL-&gt;&gt;XL: Kiểm tra quyền và phạm vi giá trị\n\n    alt Giá trị hợp lệ\n        XL-&gt;&gt;CF: Lưu cấu hình\n        CF--&gt;&gt;XL: Thành công\n        XL--&gt;&gt;UI: Hiển thị tham số mới\n    else Giá trị ngoài phạm vi\n        XL--&gt;&gt;UI: Thông báo lỗi, giữ cấu hình cũ\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-1698">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
