        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n    direction LR\n\n    state \&quot;Tiếp nhận và phân loại\&quot; as TiepNhan {\n        direction TB\n\n        state \&quot;Dự kiến\&quot; as DK\n        state \&quot;Kiểm nhận đạt\&quot; as Dat\n        state \&quot;Cách ly\&quot; as CachLy\n        state \&quot;Trong khu chờ\&quot; as Cho\n\n        [*] --&gt; DK\n        DK --&gt; Dat : Kiểm nhận đạt\n        DK --&gt; CachLy : Phát hiện lỗi\n        CachLy --&gt; Dat : Kiểm tra lại đạt\n        Dat --&gt; Cho : Bố trí đúng miền, còn chỗ\n    }\n\n    state \&quot;Phân bổ và giao\&quot; as VanChuyen {\n        direction TB\n\n        state \&quot;Đã phân bổ\&quot; as PB\n        state \&quot;Đã xếp lên xe\&quot; as Xep\n        state \&quot;Đang giao\&quot; as Giao\n        state \&quot;Đã giao\&quot; as Xong\n\n        PB --&gt; Xep : Kho xác nhận xếp\n        Xep --&gt; PB : Dỡ khỏi xe\n        Xep --&gt; Giao : Xe thực tế rời kho\n        Giao --&gt; Giao : Giao thất bại\n        Giao --&gt; Xong : Khách nhận nguyên thùng\n    }\n\n    state \&quot;Hoàn hàng\&quot; as Hoan {\n        direction TB\n\n        state \&quot;Chờ hoàn\&quot; as ChoHoan\n        state \&quot;Đã nhận hoàn\&quot; as NhanHoan\n\n        ChoHoan --&gt; NhanHoan : Kho nhận lại thực tế\n    }\n\n    [*] --&gt; TiepNhan : Nhập Excel\n    Cho --&gt; PB : Phân bổ hợp lệ\n    PB --&gt; Cho : Bỏ phân bổ\n    Giao --&gt; ChoHoan : Ghi yêu cầu hoàn\n    NhanHoan --&gt; Dat : Kiểm tra lại đạt\n    NhanHoan --&gt; CachLy : Kiểm tra không đạt\n    Xong --&gt; [*]&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-804">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
