        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor ND as Người dùng\n    participant UI as Tài khoản cá nhân\n    participant XL as Xử lý tài khoản\n    participant TK as NguoiDung\n\n    ND-&gt;&gt;UI: Nhập mật khẩu hiện tại và mật khẩu mới\n    UI-&gt;&gt;XL: Yêu cầu đổi mật khẩu\n    XL-&gt;&gt;TK: Đọc tài khoản đang đăng nhập\n    TK--&gt;&gt;XL: Mật khẩu mã hóa hiện tại\n    XL-&gt;&gt;XL: Kiểm tra mật khẩu và độ dài mới\n\n    alt Mật khẩu hiện tại đúng và mật khẩu mới hợp lệ\n        XL-&gt;&gt;XL: Mã hóa mật khẩu mới\n        XL-&gt;&gt;TK: Cập nhật mật khẩu\n        TK--&gt;&gt;XL: Lưu thành công\n        XL--&gt;&gt;UI: Đổi mật khẩu thành công\n    else Không hợp lệ\n        XL--&gt;&gt;UI: Thông báo lỗi, không lưu\n    end\n    UI--&gt;&gt;ND: Hiển thị kết quả&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-1077">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
