        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    direction TB\n\n    nguoi_dung {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar email UK\n        varchar password\n        varchar role\n        boolean active\n        timestamptz created_at\n    }\n\n    khach_hang {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar phone\n        boolean active\n    }\n\n    dia_diem_giao {\n        bigserial id PK\n        bigint customer_id FK\n        varchar code UK\n        varchar name\n        text address\n        varchar region\n        numeric latitude\n        numeric longitude\n        boolean active\n    }\n\n    don_hang {\n        bigserial id PK\n        varchar code UK\n        bigint customer_id FK\n        bigint created_by FK\n        varchar status\n        timestamptz created_at\n        text note\n    }\n\n    yeu_cau_giao {\n        bigserial id PK\n        varchar code UK\n        bigint order_id FK\n        bigint location_id FK\n        date earliest\n        date latest\n        text early_consent\n        varchar status\n    }\n\n    chi_tiet_yeu_cau {\n        bigserial id PK\n        bigint requirement_id FK\n        bigint part_id FK\n        integer quantity\n    }\n\n    linh_kien {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar unit\n        boolean active\n    }\n\n    nha_cung_cap {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar phone\n        boolean active\n    }\n\n    xac_nhan_cung_cap {\n        bigserial id PK\n        bigint supplier_id FK\n        bigint detail_id FK\n        integer quantity\n        date promised_date\n        varchar status\n        text note\n        bigint created_by FK\n        timestamptz created_at\n    }\n\n    xe {\n        bigserial id PK\n        varchar code UK\n        varchar plate UK\n        varchar region\n        numeric capacity_kg\n        boolean active\n    }\n\n    chuyen_nhap {\n        bigserial id PK\n        varchar code UK\n        bigint vehicle_id FK\n        timestamptz planned_at\n        varchar status\n        bigint created_by FK\n        timestamptz unloaded_at\n        text note\n    }\n\n    lo_nhap {\n        bigserial id PK\n        varchar code UK\n        bigint inbound_id FK\n        bigint supplier_id FK\n    }\n\n    khu_cho {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar region\n        integer capacity\n        boolean active\n    }\n\n    thung_hang {\n        bigserial id PK\n        varchar code UK\n        varchar source_code\n        bigint lot_id FK\n        bigint part_id FK\n        bigint detail_id FK\n        bigint supply_id FK\n        integer expected_qty\n        integer quantity\n        numeric gross_kg\n        varchar status\n        bigint staging_id FK\n        bigint inspected_by FK\n        timestamptz inspected_at\n        timestamptz staged_at\n        text note\n    }\n\n    cong_kho {\n        bigserial id PK\n        varchar code UK\n        varchar name\n        varchar kind\n        boolean active\n    }\n\n    luot_phuc_vu {\n        bigserial id PK\n        bigint gate_id FK\n        bigint inbound_id FK\n        bigint outbound_id FK\n        timestamptz planned_start\n        timestamptz planned_end\n        timestamptz arrived_at\n        timestamptz left_at\n        varchar status\n        bigint created_by FK\n    }\n\n    chuyen_xuat {\n        bigserial id PK\n        varchar code UK\n        bigint vehicle_id FK\n        varchar region\n        varchar driver\n        timestamptz planned_at\n        varchar status\n        bigint created_by FK\n        timestamptz dispatched_at\n        bigint dispatched_by FK\n        text underload_reason\n        text note\n    }\n\n    diem_giao_chuyen {\n        bigserial id PK\n        bigint trip_id FK\n        bigint location_id FK\n        integer sequence_no\n        text address_snapshot\n        varchar status\n    }\n\n    phan_bo_thung {\n        bigserial id PK\n        bigint box_id FK\n        bigint stop_id FK\n        varchar status\n        bigint allocated_by FK\n        timestamptz allocated_at\n        bigint loaded_by FK\n        timestamptz loaded_at\n    }\n\n    ket_qua_giao_hang {\n        bigserial id PK\n        bigint stop_id FK\n        timestamptz delivered_at\n        bigint recorded_by FK\n        text note\n        timestamptz created_at\n    }\n\n    chi_tiet_giao {\n        bigserial id PK\n        bigint result_id FK\n        bigint allocation_id FK\n        varchar status\n        boolean late\n        text note\n    }\n\n    nguoi_dung ||--o{ don_hang : created_by\n\n    khach_hang ||--o{ don_hang : customer_id\n    khach_hang ||--o{ dia_diem_giao : customer_id\n\n    don_hang ||--o{ yeu_cau_giao : order_id\n    dia_diem_giao ||--o{ yeu_cau_giao : location_id\n\n    yeu_cau_giao ||--o{ chi_tiet_yeu_cau : requirement_id\n    linh_kien ||--o{ chi_tiet_yeu_cau : part_id\n\n    nha_cung_cap ||--o{ xac_nhan_cung_cap : supplier_id\n    chi_tiet_yeu_cau ||--o{ xac_nhan_cung_cap : detail_id\n\n    xe ||--o{ chuyen_nhap : vehicle_id\n    chuyen_nhap ||--o{ lo_nhap : inbound_id\n    nha_cung_cap ||--o{ lo_nhap : supplier_id\n\n    lo_nhap ||--o{ thung_hang : lot_id\n    linh_kien ||--o{ thung_hang : part_id\n    chi_tiet_yeu_cau ||--o{ thung_hang : detail_id\n    xac_nhan_cung_cap ||--o{ thung_hang : supply_id\n    khu_cho |o--o{ thung_hang : staging_id\n\n    cong_kho ||--o{ luot_phuc_vu : gate_id\n    chuyen_nhap |o--o{ luot_phuc_vu : inbound_id\n    chuyen_xuat |o--o{ luot_phuc_vu : outbound_id\n\n    xe ||--o{ chuyen_xuat : vehicle_id\n    chuyen_xuat ||--o{ diem_giao_chuyen : trip_id\n    dia_diem_giao ||--o{ diem_giao_chuyen : location_id\n\n    thung_hang ||--o{ phan_bo_thung : box_id\n    diem_giao_chuyen ||--o{ phan_bo_thung : stop_id\n\n    diem_giao_chuyen ||--o{ ket_qua_giao_hang : stop_id\n    ket_qua_giao_hang ||--o{ chi_tiet_giao : result_id\n    phan_bo_thung ||--o{ chi_tiet_giao : allocation_id\n\n    classDef default fill:#ffffff,stroke:#000000,color:#000000;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="GrRxEbsTy6TMWkPtejgk-3462">
